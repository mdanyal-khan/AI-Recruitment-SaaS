# This file documents all environment variables needed for the project
# Copy the relevant sections to backend/.env and frontend/.env

# ============================================
# BACKEND CONFIGURATION (.env in backend/)
# ============================================

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ai_recruitment

# JWT
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Groq AI
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-20b

# ============================================
# FRONTEND CONFIGURATION (.env in frontend/)
# ============================================

# API
REACT_APP_API_URL=http://localhost:8000
REACT_APP_API_BASE_URL=http://localhost:8000/api

# Other frontend env variables as needed
